# ============================================================
# CLASSE PRINCIPAL DO MOTOR (Integrada com a GUI)
# ============================================================
class WFEManager:
    def __init__(self, config_dados, log_callback, progress_callback, is_running_callback):
        # Callbacks de Comunicação com a Interface
        self.log = log_callback
        self.progress = progress_callback
        self.is_running = is_running_callback

        # Dados oriundos da Interface (Dicionário do app.py)
        self.EA_NAME = config_dados['ea_name']
        self.SYMBOL = config_dados['symbol']
        self.PERIOD = config_dados['period_val']     # Valor numérico (ex: 30)
        self.PERIOD_NAME = config_dados['period_name'] # Nome (ex: "30M")
        self.N_JANELAS = config_dados['n_janelas']
        self.TRAIN_UNTIL_YEAR = config_dados['train_until_year']
        self.TRAIN_YEARS = config_dados['train_months']
        self.FORWARD_YEARS = config_dados['forward_months']
        self.PARAMS_OTIMIZADOS = config_dados['parametros_otimizados']
        self.CONFIGS_ATIVAS = config_dados['configuracoes_ativas']

        # Configurações Estáticas Internas do Motor
        self.OPTIMIZATION_MODE = 2
        self.OPTIMIZATION_CRITERION = 6
        self.REPLACE_EXISTING_REPORT = True
        self.XML_WAIT_SECONDS = 35 # Aumentado levemente para segurança

        self.EA_RELATIVE_PATH = Path("MQL5") / "Experts" / "Advisors" / f"{self.EA_NAME}.ex5"
        self.BASE_DIR = Path(__file__).resolve().parent
        self.RESULTS_DIR = self.BASE_DIR / "results"
        
        # ORGANIZAÇÃO DE PASTAS: results/walk_forward/30M
        self.WALK_DIR = self.RESULTS_DIR / "walk_forward" / self.PERIOD_NAME
        
        self.RESULTS_DIR.mkdir(parents=True, exist_ok=True)
        self.WALK_DIR.mkdir(parents=True, exist_ok=True)
        
        # LOG INICIAL COM OS CAMINHOS
        self.log(f"[SISTEMA] Diretório base de arquivos configurado em:\n  -> {self.WALK_DIR}")

        self.MT5_EXE = None

    # ========================================================
    # UTILITÁRIOS E DIRETÓRIOS
    # ========================================================
    def print_separator(self, char="=", length=70):
        self.log(char * length)

    def remove_file(self, path):
        path = Path(path)
        if path.exists():
            try:
                path.unlink()
            except Exception as exc:
                raise RuntimeError(f"Não foi possível remover o arquivo: {path.name}\nErro: {exc}")

    def copy_file(self, source, destination):
        source, destination = Path(source), Path(destination)
        if not source.exists():
            raise RuntimeError(f"Arquivo de origem não encontrado:\n{source}")

        destination.parent.mkdir(parents=True, exist_ok=True)
        if destination.exists():
            self.remove_file(destination)
        shutil.copy2(source, destination)
        return destination

    def wait_for_file(self, path, timeout_seconds):
        path = Path(path)
        deadline = time.time() + timeout_seconds
        while time.time() < deadline:
            if not self.is_running(): raise InterruptedError("Abortado pelo usuário.")
            if path.exists():
                try:
                    if path.stat().st_size > 0:
                        return True
                except OSError: pass
            time.sleep(1)
        return False

    def build_windows(self):
        import datetime
        
        def add_months(sourcedate, months):
            month = sourcedate.month - 1 + months
            year = sourcedate.year + month // 12
            month = month % 12 + 1
            day = 1 # Sempre usamos o dia 1 para WFO padrão
            return datetime.date(year, month, day)

        windows = []
        
        # Data final do último Forward (Alvo: 1º de Janeiro do ano escolhido)
        # Ex: Se TRAIN_UNTIL_YEAR é 2025, o fim total é 2025.01.01
        final_date = datetime.date(self.TRAIN_UNTIL_YEAR, 1, 1)

        # Precisamos calcular as janelas de trás para frente para alinhar com a data alvo
        # Mas vamos armazenar na ordem cronológica (da mais antiga para a mais nova)
        
        temp_windows = []
        current_end_point = final_date

        for i in range(self.N_JANELAS):
            # O forward termina no ponto atual
            forward_to = current_end_point
            # O forward começa X meses antes
            forward_from = add_months(forward_to, -self.FORWARD_YEARS) # Aqui FORWARD_YEARS agora são meses
            
            # O treino termina onde o forward começa
            train_to = forward_from
            # O treino começa X meses antes do fim do treino
            train_from = add_months(train_to, -self.TRAIN_YEARS) # Aqui TRAIN_YEARS agora são meses

            # Formata para string MT5 (YYYY.MM.DD)
            temp_windows.append((
                train_from.strftime("%Y.%m.%d"),
                train_to.strftime("%Y.%m.%d"),
                forward_from.strftime("%Y.%m.%d"),
                forward_to.strftime("%Y.%m.%d")
            ))

            # O próximo ponto final (da janela anterior) é onde este Forward começou
            # Isso cria o efeito de "Walk-Forward" (rolagem)
            current_end_point = forward_from

        # Inverte a lista para que a execução comece pela data mais antiga
        windows = list(reversed(temp_windows))
        
        self.log(f"[MATEMÁTICA] Janelas calculadas em meses. Início da primeira janela: {windows[0][0]}")
        return windows

    def find_mt5_exe(self):
        candidates = [
            Path(r"C:\Program Files\MetaTrader 5\terminal64.exe"),
            Path(r"C:\Program Files (x86)\MetaTrader 5\terminal64.exe"),
            Path(r"C:\ProgramData\Microsoft\Windows\Start Menu\Programs\MetaTrader 5\terminal64.exe"),
        ]
        for candidate in candidates:
            if candidate.exists(): return candidate
        return None

    def find_ea_terminal(self):
        appdata = os.environ.get("APPDATA")
        if not appdata: return None, None
        root = Path(appdata) / "MetaQuotes" / "Terminal"
        if not root.exists(): return None, None

        matches = []
        for terminal_dir in root.iterdir():
            if not terminal_dir.is_dir(): continue
            ea_path = terminal_dir / self.EA_RELATIVE_PATH
            if ea_path.exists(): matches.append((terminal_dir, ea_path))

        if not matches: return None, None
        matches.sort(key=lambda item: item[1].stat().st_mtime, reverse=True)
        return matches[0]

    # ========================================================
    # GERAÇÃO INI E EXECUÇÃO
    # ========================================================
    def create_optimization_ini(self, path, train_from, train_to, forward_from, forward_to, report_name, configuracao):
        config_ea = MAPA_CENARIOS.get(configuracao, {})
        content = f"""[Tester]
Expert=Advisors\\{self.EA_NAME}
Symbol={self.SYMBOL}
Period={self.PERIOD}
Model=2
Optimization={self.OPTIMIZATION_MODE}
OptimizationCriterion={self.OPTIMIZATION_CRITERION}
FromDate={train_from}
ToDate={forward_to}
ForwardMode=4
ProfitInPips=0
ForwardDate={forward_from}
Report={report_name}
ReplaceReport={1 if self.REPLACE_EXISTING_REPORT else 0}
ShutdownTerminal=1
UseLocal=1
UseRemote=0
UseCloud=0
Visual=0

[TesterInputs]
"""
        for chave, valor in config_ea.items():
            content += f"{chave}={valor}||0||0||0||N\n"

        for param_name, (start, step, stop) in self.PARAMS_OTIMIZADOS.items():
            content += f"{param_name}={start}||{start}||{step}||{stop}||Y\n"

        path = Path(path)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")
        
        self.log(f"[ARQUIVO] Arquivo de inicialização (INI) gerado em:\n  -> {path}")

    def run_mt5(self, config_file):
        command = [str(self.MT5_EXE), f"/config:{config_file}"]
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        
        while process.poll() is None:
            if not self.is_running():
                process.terminate()
                process.wait()
                raise InterruptedError("MT5 abortado pelo usuário.")
            time.sleep(1)

        if process.returncode != 0:
            raise RuntimeError(f"O MetaTrader 5 falhou (Erro {process.returncode}).")

    # ========================================================
    # XML MANAGER
    # ========================================================
    def preserve_xml(self, terminal_data_dir, report_name, destination_dir, is_forward=False):
        sufixo = ".forward.xml" if is_forward else ".xml"
        source = Path(terminal_data_dir) / f"{report_name}{sufixo}"
        destination = Path(destination_dir) / f"{report_name}{sufixo}"

        if not self.wait_for_file(source, self.XML_WAIT_SECONDS):
            raise RuntimeError(f"Timeout aguardando {source.name}. O MetaTrader pode ter travado ou não gerou o relatório.")

        self.copy_file(source, destination)
        self.log(f"[ARQUIVO] Relatório MT5 resgatado de:\n  -> {source}\n  -> Salvo para: {destination}")
        return destination

    def execute_window(self, configuracao, window_number, train_from, train_to, forward_from, forward_to, terminal_data_dir):
        self.log(f"  -> {self.PERIOD_NAME} | {configuracao} | Janela {window_number}/{self.N_JANELAS}")

        window_dir = self.WALK_DIR / configuracao / f"janela_{window_number}"
        window_dir.mkdir(parents=True, exist_ok=True)
        
        report_name = f"otimizacao_{window_number}"
        ini_path = window_dir / f"{report_name}.ini"

        self.create_optimization_ini(ini_path, train_from, train_to, forward_from, forward_to, report_name, configuracao)
        self.run_mt5(ini_path)

        xml_back = self.preserve_xml(terminal_data_dir, report_name, window_dir, False)
        xml_forward = self.preserve_xml(terminal_data_dir, report_name, window_dir, True)

        return {
            "window": window_number,
            "xml": str(xml_back),
            "forward_xml": str(xml_forward),
        }

    # ========================================================
    # INTEGRAÇÃO ROBUSTNESS
    # ========================================================
    def run_robustness(self, configuracao, results):
        robustness_path = self.BASE_DIR / "robustness.py"
        if not robustness_path.exists(): 
            self.log("[ERRO] Arquivo robustness.py não encontrado!")
            return

        pasta_analise = self.WALK_DIR / configuracao
        pasta_analise.mkdir(parents=True, exist_ok=True)

        for item in results:
            shutil.copy2(item["xml"], pasta_analise / f"otimizacao_{item['window']}.xml")
            shutil.copy2(item["forward_xml"], pasta_analise / f"otimizacao_{item['window']}.forward.xml")

        parametros_str = ",".join(self.PARAMS_OTIMIZADOS.keys())
        
        command = [
            sys.executable, 
            str(robustness_path), 
            configuracao, 
            parametros_str, 
            self.EA_NAME, 
            str(self.N_JANELAS), 
            str(pasta_analise),
            self.PERIOD_NAME
        ]

        self.log(f"\n[SISTEMA] Iniciando análise de Robustez. Enviando XMLs para processamento.")
        
        try:
            process_result = subprocess.run(command, cwd=str(self.BASE_DIR), capture_output=True, text=True)
            
            if process_result.stdout:
                self.log(process_result.stdout.strip())
            
            if process_result.stderr:
                self.log(f"[❌ ERRO NA ROBUSTEZ - STDERR]\n{process_result.stderr.strip()}")
            
            if process_result.returncode == 0:
                self.log(f"[OK] Módulo de robustez concluído com sucesso para a configuração {configuracao}.")
            else:
                self.log(f"[ERRO] O script robustness.py retornou código de falha: {process_result.returncode}")

        except Exception as e:
            self.log(f"[❌ ERRO FATAL AO CHAMAR ROBUSTNESS]\n{traceback.format_exc()}")

    # ========================================================
    # INTEGRAÇÃO AUTO-PRUNER (NOVO)
    # ========================================================
    def run_auto_pruner(self, configuracao):
        pruner_path = self.BASE_DIR / "auto_pruner.py"
        
        if not pruner_path.exists():
            self.log("[AVISO] auto_pruner.py não encontrado. Pulando poda de parâmetros.")
            return

        import re
        def limpar_nome(texto):
            return re.sub(r'[<>:"/\\|?*]', '_', str(texto))

        ea_limpo = limpar_nome(self.EA_NAME)
        intervalo_limpo = limpar_nome(self.PERIOD_NAME)
        config_limpa = limpar_nome(configuracao)
        
        csv_dir = self.BASE_DIR / "robustness_output" / "csv" / ea_limpo / intervalo_limpo
        csv_path = csv_dir / f"{config_limpa}_Dados_Master_Forward.csv"

        if not csv_path.exists():
            self.log(f"[ERRO] CSV Base não encontrado para o Auto-Pruner em:\n{csv_path}")
            return

        parametros_str = ",".join(self.PARAMS_OTIMIZADOS.keys())
        
        # Define Nível 1 e salva na pasta raiz dos resultados para a Interface ler
        agressividade = "1" 
        json_out = self.RESULTS_DIR / "novos_ranges.json"

        command = [
            sys.executable,
            str(pruner_path),
            str(csv_path),
            parametros_str,
            "--agressividade", agressividade,
            "--out", str(json_out)
        ]

        try:
            self.log("\n[SISTEMA] Iniciando matemática do Auto-Pruner...")
            
            # Força o ambiente filho a usar UTF-8 no console
            env = os.environ.copy()
            env["PYTHONIOENCODING"] = "utf-8"
            
            process_result = subprocess.run(
                command, 
                cwd=str(self.BASE_DIR), 
                capture_output=True, 
                text=True, 
                encoding="utf-8", # Exige leitura em UTF-8
                env=env           # Injeta a variável de ambiente
            )
            
            if process_result.stdout:
                self.log(process_result.stdout.strip())
            
            if process_result.stderr:
                self.log(f"[❌ ERRO NO AUTO-PRUNER - STDERR]\n{process_result.stderr.strip()}")
            
        except Exception as e:
            self.log(f"[❌ ERRO FATAL AO CHAMAR AUTO-PRUNER]\n{traceback.format_exc()}")


    # ========================================================
    # MOTOR PRINCIPAL
    # ========================================================
    def run_all(self):
        self.MT5_EXE = self.find_mt5_exe()
        if not self.MT5_EXE: raise RuntimeError("MT5 não encontrado.")
        
        terminal_data_dir, ea_path = self.find_ea_terminal()
        if not terminal_data_dir: raise RuntimeError(f"EA {self.EA_NAME} não encontrado.")

        windows = self.build_windows()
        
        passo_atual = 0

        for configuracao in self.CONFIGS_ATIVAS:
            if not self.is_running(): raise InterruptedError("Cancelado.")
            
            config_results = []
            for i, window in enumerate(windows, start=1):
                if not self.is_running(): raise InterruptedError("Cancelado.")
                
                res = self.execute_window(configuracao, i, window[0], window[1], window[2], window[3], terminal_data_dir)
                config_results.append(res)
                
                passo_atual += 1
                self.progress(passo_atual, len(self.CONFIGS_ATIVAS) * self.N_JANELAS)
                
            # Chama o analizador de robustez para criar o CSV
            self.run_robustness(configuracao, config_results)
            
            # Chama o Pruner para gerar o arquivo novos_ranges.json
            self.run_auto_pruner(configuracao)
