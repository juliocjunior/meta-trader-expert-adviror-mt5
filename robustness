# -*- coding: utf-8 -*-

"""
ROBUSTNESS ANALYZER UNIVERSAL (ALTA RESOLUÇÃO)
=============================================================
Analisa os XMLs de otimização passados pelo app.py.
Mantém todas as estatísticas visuais (Profit, Trades, %) nos PNGs.
"""

import os
import csv
import math
import sys
import xml.etree.ElementTree as ET
from collections import defaultdict
from pathlib import Path
import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns

# ============================================================
# VARIÁVEIS GLOBAIS
# ============================================================
N_JANELAS = 4
EA_NOME = "Generic_EA"
PARAMETROS = []
CONFIGURACAO_ATUAL = "PADRAO"
XML_DIR = ""
INTERVALO = "30 min"  # Valor padrão, pode ser recebido via sys.argv

# Colunas fixas do MetaTrader 5
COLUNA_BACK_RESULT = "Result"
COLUNA_FORWARD_RESULT = "Forward Result"
COLUNA_PROFIT = "Profit"
COLUNA_TRADES = "Trades"

# ============================================================
# DIRETÓRIO DE SAÍDA
# ============================================================
BASE_DIR = Path(__file__).resolve().parent
OUTPUT_DIR = BASE_DIR / "robustness_output"
PNG_BASE_DIR = OUTPUT_DIR / "png"
CSV_DIR = OUTPUT_DIR / "csv"

# ============================================================
# UTILITÁRIOS
# ============================================================
def garantir_diretorios():
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    PNG_BASE_DIR.mkdir(parents=True, exist_ok=True)
    CSV_DIR.mkdir(parents=True, exist_ok=True)

def limpar_nome_arquivo(texto):
    caracteres = '<>:"/\\|?*'
    resultado = texto
    for caractere in caracteres:
        resultado = resultado.replace(caractere, "_")
    return resultado

def numero(texto):
    if texto is None: return None
    texto = str(texto).strip().replace(",", ".")
    try:
        valor = float(texto)
        return None if math.isnan(valor) else valor
    except: return None

def valor_numerico_parametro(texto):
    val = numero(texto)
    if val is None: return None
    return int(val) if val.is_integer() else val

# ============================================================
# XML
# ============================================================
def nome_local(tag):
    return tag.split("}", 1)[1] if "}" in tag else tag

def encontrar_planilha(root):
    for elemento in root.iter():
        if nome_local(elemento.tag).lower() == "table":
            return elemento
    return None

def encontrar_linhas(table):
    return [el for el in table if nome_local(el.tag).lower() == "row"]

def extrair_celulas(row):
    valores = []
    for cell in row:
        if nome_local(cell.tag).lower() != "cell": continue
        texto = ""
        for filho in cell.iter():
            if nome_local(filho.tag).lower() == "data":
                texto = filho.text if filho.text else ""
                break
        valores.append(texto.strip())
    return valores

def ler_xml(caminho, tipo):
    if not os.path.isfile(caminho):
        raise FileNotFoundError(f"Arquivo não encontrado: {caminho}")

    tree = ET.parse(caminho)
    root = tree.getroot()
    table = encontrar_planilha(root)
    if table is None: raise RuntimeError("Tabela não encontrada.")

    linhas = encontrar_linhas(table)
    header = extrair_celulas(linhas[0])

    resultado_coluna = COLUNA_BACK_RESULT if tipo == "back" else COLUNA_FORWARD_RESULT
    obrigatorias = [resultado_coluna, COLUNA_PROFIT, COLUNA_TRADES] + PARAMETROS
    
    indices = {nome: header.index(nome) for nome in obrigatorias if nome in header}
    if len(indices) < len(obrigatorias):
        faltando = [c for c in obrigatorias if c not in header]
        raise RuntimeError(f"Colunas faltando: {faltando}")

    registros = []
    for row in linhas[1:]:
        valores = extrair_celulas(row)
        if len(valores) < len(header): continue
        
        res = numero(valores[indices[resultado_coluna]])
        prof = numero(valores[indices[COLUNA_PROFIT]])
        tra = numero(valores[indices[COLUNA_TRADES]])

        params_linha = {}
        valido = True
        for p in PARAMETROS:
            val = valor_numerico_parametro(valores[indices[p]])
            if val is None: valido = False; break
            params_linha[p] = val
        
        if valido and res is not None:
            reg = {"result": res, "profit": prof, "trades": tra}
            reg.update(params_linha)
            registros.append(reg)
    return registros

# ============================================================
# CÁLCULOS MATEMÁTICOS
# ============================================================
def calcular_medias_janela(registros, parametro, chave_metrica="result"):
    grupos = defaultdict(list)
    for r in registros:
        grupos[r[parametro]].append(r[chave_metrica])
    return {v: sum(l)/len(l) for v, l in grupos.items() if l}

def calcular_media_das_janelas(medias_janelas):
    valores = set()
    for d in medias_janelas.values(): valores.update(d.keys())
    res = {}
    for v in valores:
        lista = [medias_janelas[j][v] for j in sorted(medias_janelas) if v in medias_janelas[j]]
        if lista: res[v] = sum(lista) / len(lista)
    return res

def calcular_estatisticas_forward(dados_forward):
    profits, trades = [], []
    for janela in dados_forward:
        for registro in dados_forward[janela]:
            if registro.get("profit") is not None: profits.append(registro["profit"])
            if registro.get("trades") is not None: trades.append(registro["trades"])
    
    mp = sum(profits)/len(profits) if profits else None
    pos = sum(1 for p in profits if p > 0)
    pp = (pos / len(profits) * 100.0) if profits else None
    mt = sum(trades)/len(trades) if trades else None
    return {"media_profit": mp, "media_trades": mt, "percentual_positivo": pp, 
            "total_configuracoes": len(profits), "configuracoes_positivas": pos}

# ============================================================
# VISUALIZAÇÃO
# ============================================================
def plotar_parametro(ax, parametro, medias_janelas, metrica_nome):
    media_final = calcular_media_das_janelas(medias_janelas)
    x = sorted(media_final.keys())
    y = [media_final[v] for v in x]
    
    if x: 
        ax.plot(x, y, marker="o", linewidth=1.5, markersize=4)
        
    ax.axhline(0, linewidth=0.8, alpha=0.4, color="gray")
    ax.set_title(parametro, fontsize=11, fontweight="bold")
    ax.grid(True, alpha=0.25)

def gerar_png_forward(resultados_forward, estatisticas, configuracao, metrica_nome):
    nome_arquivo = f"{limpar_nome_arquivo(configuracao)}_{metrica_nome}.png"
    caminho = PNG_BASE_DIR / nome_arquivo
    qtd_params = len(PARAMETROS)
    cols = min(3, qtd_params) if qtd_params > 0 else 1
    rows = math.ceil(qtd_params / cols) if qtd_params > 0 else 1

    # Tamanho grande para acomodar tudo sem apertar
    fig, axes = plt.subplots(rows, cols, figsize=(18, 6 * rows))
    if qtd_params <= 1: axes = [axes]
    else: axes = axes.flatten()

    for i, p in enumerate(PARAMETROS):
        plotar_parametro(axes[i], p, resultados_forward[p], metrica_nome)
    for i in range(qtd_params, len(axes)): axes[i].axis("off")

    mp, mt, pp = estatisticas["media_profit"], estatisticas["media_trades"], estatisticas["percentual_positivo"]
    tc, cp = estatisticas["total_configuracoes"], estatisticas["configuracoes_positivas"]
    
    info = f"Média Profit: {mp:.2f}  |  Média Trades: {mt:.2f}  |  % Profit positivo: {pp:.2f}% ({cp}/{tc})"
    
    fig.suptitle(f"FORWARD — Robustness ({EA_NOME})\nConfiguração: {configuracao} | Métrica: {metrica_nome}", 
                 fontsize=16, fontweight="bold")
    fig.text(0.5, 0.93 - (0.015 * rows), info, ha="center", fontsize=11, fontweight="bold")
    
    plt.tight_layout(rect=[0, 0, 1, 0.90 - (0.01 * rows)])
    # Aumentado DPI de 160 para 300 (Altíssima resolução)
    plt.savefig(str(caminho), dpi=300, bbox_inches="tight")
    plt.close()
    return caminho

def plotar_heatmaps_combinados(dados_forward, configuracao):
    chave = "profit"
    metrica = "Profit"
    
    pares = [
        ("Espacamento_Filtro_Estocastico1", "Periodo_Filtro_Estocastico1", "Filtro Estocástico"),
        ("Linha_Filtro_ADX1", "Periodo_Filtro_ADX1", "Filtro ADX")
    ]
    
    pares_validos = []
    for py, px, titulo in pares:
        if py in PARAMETROS and px in PARAMETROS:
            df = calcular_media_2d_todas_janelas(dados_forward, py, px, chave)
            if not df.empty:
                pares_validos.append((df, py, px, titulo))
                
    if not pares_validos:
        return
        
    # Dimensões consideravelmente maiores (20, 9) para mais espaço nos gráficos
    fig, axes = plt.subplots(1, len(pares_validos), figsize=(20, 9))
    if len(pares_validos) == 1:
        axes = [axes]
        
    for i, (df, py, px, titulo) in enumerate(pares_validos):
        matriz = df.pivot(index=py, columns=px, values=f"Media_{chave.capitalize()}").sort_index(ascending=False)
        
        # Plotagem padrão do Heatmap, deixando o Seaborn cuidar dos eixos
        sns.heatmap(matriz, cmap="RdYlGn", annot=False, cbar_kws={'label': f'Média {metrica}'}, ax=axes[i])
        
        # Títulos dos subgráficos discretos
        axes[i].set_title(f"{titulo} ({py} vs {px})", fontsize=10, fontweight="normal")
        
    # Título geral
    texto_titulo = f"Heatmaps de Robustez | Config: {configuracao} | Métrica: {metrica} | Intervalo: {INTERVALO}"
    fig.suptitle(texto_titulo, fontsize=12, fontweight="normal", y=0.98)
    
    # Ajusta o layout para aproveitar todo o espaço da imagem enorme
    plt.tight_layout(rect=[0, 0, 1, 0.94])
    
    caminho = PNG_BASE_DIR / f"{limpar_nome_arquivo(configuracao)}_Heatmaps_Combinados_{metrica}.png"
    # Salvar em altíssima resolução (300 DPI) para dar zoom e ler fácil
    plt.savefig(caminho, dpi=300, bbox_inches="tight")
    plt.close()

def calcular_media_2d_todas_janelas(dados_forward, param_y, param_x, chave_metrica):
    comb = defaultdict(list)
    for j in dados_forward:
        for r in dados_forward[j]:
            vy, vx, m = r.get(param_y), r.get(param_x), r.get(chave_metrica)
            if all(v is not None for v in [vy, vx, m]): comb[(vy, vx)].append(m)
    df_data = [{param_y: k[0], param_x: k[1], f"Media_{chave_metrica.capitalize()}": sum(v)/len(v)} for k, v in comb.items()]
    return pd.DataFrame(df_data)

# ============================================================
# MAIN
# ============================================================
def main():
    global PARAMETROS, EA_NOME, CONFIGURACAO_ATUAL, N_JANELAS, XML_DIR, INTERVALO

    if len(sys.argv) < 6:
        print("\nERRO: Argumentos insuficientes.")
        return 1

    CONFIGURACAO_ATUAL = sys.argv[1].upper().strip()
    PARAMETROS = [p.strip() for p in sys.argv[2].split(",") if p.strip()]
    EA_NOME = sys.argv[3].strip()
    N_JANELAS = int(sys.argv[4])
    XML_DIR = sys.argv[5]

    # Checa se foi passado um 6º argumento contendo o intervalo
    if len(sys.argv) > 6:
        INTERVALO = sys.argv[6].strip()

    garantir_diretorios()

    dados_back, dados_forward = {}, {}
    for j in range(1, N_JANELAS + 1):
        dados_back[j] = ler_xml(os.path.join(XML_DIR, f"otimizacao_{j}.xml"), "back")
        dados_forward[j] = ler_xml(os.path.join(XML_DIR, f"otimizacao_{j}.forward.xml"), "forward")
        
    estatisticas = calcular_estatisticas_forward(dados_forward)

    for chave, nome_metrica in [("result", "Result"), ("profit", "Profit")]:
        res_forw = {p: {j: calcular_medias_janela(dados_forward[j], p, chave) for j in range(1, N_JANELAS+1)} for p in PARAMETROS}
        
        gerar_png_forward(res_forw, estatisticas, CONFIGURACAO_ATUAL, nome_metrica)

        if chave == "profit":
            plotar_heatmaps_combinados(dados_forward, CONFIGURACAO_ATUAL)

    return 0

if __name__ == "__main__":
    sys.exit(main())
