# ============================================================
# FUNÇÕES UTILITÁRIAS PURAS (Sem Estado)
# ============================================================
def limpar_nome_arquivo(texto: str) -> str:
    """Limpa caracteres inválidos para nomes de arquivos e pastas usando Regex."""
    return re.sub(r'[<>:"/\\|?*]', '_', str(texto))

def numero(texto: Union[str, float, None]) -> Optional[float]:
    """Converte texto numérico (inclusive formato PT-BR) para float."""
    if texto is None: return None
    texto = str(texto).strip().replace(",", ".")
    try:
        valor = float(texto)
        return None if math.isnan(valor) else valor
    except ValueError: 
        return None

def nome_local(tag: str) -> str:
    """Remove namespaces de tags XML."""
    return tag.split("}", 1)[1] if "}" in tag else tag

# ============================================================
# CLASSE PRINCIPAL: ROBUSTNESS ANALYZER
# ============================================================
class RobustnessAnalyzer:
    def __init__(self, configuracao: str, parametros: List[str], ea_nome: str, n_janelas: int, xml_dir: str, intervalo: str = "30 min"):
        self.configuracao = configuracao
        self.parametros = parametros
        self.ea_nome = ea_nome
        self.n_janelas = n_janelas
        self.xml_dir = Path(xml_dir)
        self.intervalo = intervalo

        # Nomes fixos das colunas do MT5
        self.col_back_result = "Result"
        self.col_forward_result = "Forward Result"
        self.col_profit = "Profit"
        self.col_trades = "Trades"

        # Configuração de Diretórios
        self.base_dir = Path(__file__).resolve().parent
        self.output_dir = self.base_dir / "robustness_output"
        self.png_dir = self.output_dir / "png" / limpar_nome_arquivo(self.ea_nome) / limpar_nome_arquivo(self.intervalo)
        self.csv_dir = self.output_dir / "csv" / limpar_nome_arquivo(self.ea_nome) / limpar_nome_arquivo(self.intervalo)

        self._garantir_diretorios()

    def _garantir_diretorios(self) -> None:
        """Cria os diretórios necessários caso não existam."""
        self.png_dir.mkdir(parents=True, exist_ok=True)
        self.csv_dir.mkdir(parents=True, exist_ok=True)

    def _salvar_csv(self, df: pd.DataFrame, nome_arquivo: str) -> None:
        """Utilitário para salvar dataframes em CSV."""
        caminho = self.csv_dir / f"{limpar_nome_arquivo(self.configuracao)}_{nome_arquivo}.csv"
        df.to_csv(caminho, sep=";", decimal=",")

    # ============================================================
    # PARSING DE XML
    # ============================================================
    def ler_xml(self, caminho: Path, tipo: str) -> List[Dict[str, Any]]:
        """Processa o XML de otimização do MT5 extraindo as métricas principais e parâmetros."""
        if not caminho.is_file():
            raise FileNotFoundError(f"Arquivo não encontrado: {caminho}")

        print(f"  [LENDO] Extraindo dados de: {caminho.name}")
        tree = ET.parse(caminho)
        root = tree.getroot()
        
        # Encontra tabela
        table = next((el for el in root.iter() if nome_local(el.tag).lower() == "table"), None)
        if table is None: raise RuntimeError("Tabela não encontrada no XML.")

        linhas = [el for el in table if nome_local(el.tag).lower() == "row"]
        
        # Extrai Header
        header = []
        for cell in linhas[0]:
            if nome_local(cell.tag).lower() == "cell":
                data = next((f.text for f in cell.iter() if nome_local(f.tag).lower() == "data"), "")
                header.append(data.strip() if data else "")

        resultado_coluna = self.col_back_result if tipo == "back" else self.col_forward_result
        obrigatorias = [resultado_coluna, self.col_profit, self.col_trades] + self.parametros
        
        indices = {nome: header.index(nome) for nome in obrigatorias if nome in header}
        if len(indices) < len(obrigatorias):
            faltando = [c for c in obrigatorias if c not in header]
            raise RuntimeError(f"Colunas faltando: {faltando}")

        # Busca dinâmica de métricas secundárias (Drawdown e Profit Factor)
        for c in header:
            c_lower = c.lower()
            if "dd" in c_lower or "drawdown" in c_lower or "rebaixamento" in c_lower:
                indices["drawdown"] = header.index(c)
            elif "profit factor" in c_lower or "fator de lucro" in c_lower:
                indices["profit_factor"] = header.index(c)

        registros = []
        for row in linhas[1:]:
            valores = []
            for cell in row:
                if nome_local(cell.tag).lower() == "cell":
                    data = next((f.text for f in cell.iter() if nome_local(f.tag).lower() == "data"), "")
                    valores.append(data.strip() if data else "")

            if len(valores) < len(header): continue
            
            res = numero(valores[indices[resultado_coluna]])
            prof = numero(valores[indices[self.col_profit]])
            tra = numero(valores[indices[self.col_trades]])
            dd_val = numero(valores[indices["drawdown"]]) if "drawdown" in indices else 0.0
            pf_val = numero(valores[indices["profit_factor"]]) if "profit_factor" in indices else 0.0

            params_linha = {}
            valido = True
            for p in self.parametros:
                val = numero(valores[indices[p]])
                if val is None: 
                    valido = False
                    break
                params_linha[p] = int(val) if val.is_integer() else val
            
            if valido and res is not None:
                # Otimização: Unpacking de dicionário (Python 3.5+)
                reg = {
                    "result": res, "profit": prof, "trades": tra, 
                    "drawdown": dd_val, "profit_factor": pf_val,
                    **params_linha
                }
                registros.append(reg)
                
        return registros

    # ============================================================
    # CÁLCULOS MATEMÁTICOS
    # ============================================================
    def calcular_medias_janela(self, registros: List[Dict[str, Any]], parametro: str, chave_metrica: str = "result") -> Dict[float, float]:
        grupos = defaultdict(list)
        for r in registros:
            if r.get(chave_metrica) is not None:
                grupos[r[parametro]].append(r[chave_metrica])
        return {v: sum(l)/len(l) for v, l in grupos.items() if l}

    def calcular_media_das_janelas(self, medias_janelas: Dict[int, Dict[float, float]]) -> Dict[float, float]:
        valores = set()
        for d in medias_janelas.values(): valores.update(d.keys())
        res = {}
        for v in valores:
            lista = [medias_janelas[j][v] for j in sorted(medias_janelas) if v in medias_janelas[j]]
            if lista: res[v] = sum(lista) / len(lista)
        return res

    def calcular_estatisticas_forward(self, dados_forward: Dict[int, List[Dict[str, Any]]]) -> Dict[str, Any]:
        profits, trades = [], []
        for registros in dados_forward.values():
            for registro in registros:
                if registro.get("profit") is not None: profits.append(registro["profit"])
                if registro.get("trades") is not None: trades.append(registro["trades"])
        
        mp = sum(profits)/len(profits) if profits else 0.0
        pos = sum(1 for p in profits if p > 0)
        pp = (pos / len(profits) * 100.0) if profits else 0.0
        mt = sum(trades)/len(trades) if trades else 0.0
        
        estatisticas = {"media_profit": mp, "media_trades": mt, "percentual_positivo": pp, 
                        "total_configuracoes": len(profits), "configuracoes_positivas": pos}
        
        self._salvar_csv(pd.DataFrame([estatisticas]), "Forward_Stats_Global")
        return estatisticas

    def calcular_winrate_consistencia(self, dados_forward: Dict[int, List[Dict[str, Any]]], parametro: str) -> Dict[float, float]:
        vitorias_por_valor = defaultdict(int)
        total_testes_por_valor = defaultdict(int)
        
        for registros in dados_forward.values():
            for registro in registros:
                valor_param = registro.get(parametro)
                profit = registro.get("profit")
                
                if valor_param is not None and profit is not None:
                    total_testes_por_valor[valor_param] += 1
                    if profit > 0:
                        vitorias_por_valor[valor_param] += 1
                        
        return {valor: (vitorias_por_valor[valor] / total_testes) * 100.0 
                for valor, total_testes in total_testes_por_valor.items() if total_testes > 0}

    # ============================================================
    # VISUALIZAÇÃO E GRÁFICOS (ALTA RESOLUÇÃO)
    # ============================================================
    def gerar_png_plato_e_winrate(self, resultados_profit: Dict[str, Any], dados_forward: Dict[int, List[Dict[str, Any]]], estatisticas: Dict[str, Any]) -> None:
            """Gera um gráfico combinado: Linha 1 (Plateau), Linha 2 (WinRate) e Linhas Seguintes (Matriz de Heatmaps Todos vs Todos transposta)"""
            metrica_nome = "Plateau_Stability_and_WinRate"
            caminho = self.png_dir / f"{limpar_nome_arquivo(self.configuracao)}_{metrica_nome}.png"
            
            mp, mt, pp = estatisticas["media_profit"], estatisticas["media_trades"], estatisticas["percentual_positivo"]
            tc, cp = estatisticas["total_configuracoes"], estatisticas["configuracoes_positivas"]
            info = f"Média Profit: {mp:.2f}   |   Média Trades: {mt:.2f}   |   % Profit positivo: {pp:.2f}% ({cp}/{tc})"

            qtd_params = len(self.parametros)
            cols = qtd_params if qtd_params > 0 else 1
            
            # Número de linhas dinâmico (2 fixas + 1 para cada parâmetro)
            rows = 2 + qtd_params 

            largura_coluna = 26.0 / 3.0  
            altura_linha = 9.0
            
            # Otimização: squeeze=False garante matriz 2D, removendo necessidade de reshape manual
            fig, axes = plt.subplots(rows, cols, figsize=(largura_coluna * cols, altura_linha * rows), squeeze=False)

            df_csv_list = []
            resultados_tr = {p: {j: self.calcular_medias_janela(dados_forward[j], p, "trades") for j in range(1, self.n_janelas+1)} for p in self.parametros}

            # Otimização de Memória/Velocidade: Criando um único DataFrame global para a Matriz de Heatmaps
            todos_registros = []
            for registros in dados_forward.values():
                todos_registros.extend(registros)
            df_forward_all = pd.DataFrame(todos_registros)

            for i, p in enumerate(self.parametros):
                # ==============================
                # LINHA 0: ESTABILIDADE DO PLATÔ
                # ==============================
                ax_plato = axes[0, i]
                
                media_final = self.calcular_media_das_janelas(resultados_profit[p])
                x = sorted(media_final.keys())
                y = [media_final[v] for v in x]
                
                if len(x) >= 3:
                    x_array = np.round(np.array(x, dtype=float), 6)
                    diffs = np.round(np.diff(x_array), 6)
                    step = np.min(diffs[diffs > 0]) if len(diffs[diffs > 0]) > 0 else 1.0
                    
                    num_steps = int(np.round((np.max(x_array) - np.min(x_array)) / step)) + 1
                    idx_uniform = np.linspace(np.min(x_array), np.max(x_array), num_steps)
                    idx_uniform = np.round(idx_uniform, 6)
                    
                    idx_combined = np.sort(np.unique(np.union1d(idx_uniform, x_array)))
                    
                    df = pd.DataFrame({'x': x_array, 'y': y}).drop_duplicates(subset=['x']).set_index('x')
                    df_uniform = df.reindex(idx_combined)
                    
                    df_uniform['mean'] = df_uniform['y'].rolling(window=3, center=True, min_periods=1).mean()
                    df_uniform['std'] = df_uniform['y'].rolling(window=3, center=True, min_periods=1).std().fillna(0)
                    
                    df_plot = df_uniform.loc[x_array]
                    
                    ax_plato.fill_between(df_plot.index, df_plot['mean'] - df_plot['std'], df_plot['mean'] + df_plot['std'], 
                                    color='tab:blue', alpha=0.15, label='Volatilidade (± 1 Std Dev)')
                    ax_plato.plot(df_plot.index, df_plot['mean'], color='tab:blue', marker='o', linewidth=3, 
                            markersize=7, label='Média da Vizinhança')
                    ax_plato.plot(df_plot.index, df_plot['y'], color='gray', linestyle=':', linewidth=2, alpha=0.6, label='Profit Real')
                    
                    ax_plato.legend(loc="upper left", fontsize=12)
                    
                    df_csv = df_plot.rename(columns={'y': f'{p}_Profit_Real', 'mean': f'{p}_Media_Vizinhos', 'std': f'{p}_Std_Dev'})
                    df_csv.index.name = p
                    df_csv_list.append(df_csv)
                else:
                    ax_plato.plot(x, y, marker="o", color="tab:blue", linewidth=3, markersize=7)
                    
                ax_plato.axhline(0, linewidth=1.2, alpha=0.4, color="black")
                ax_plato.set_title(f"{p} (Estabilidade da Vizinhança)", fontsize=15, fontweight="bold")
                ax_plato.set_ylabel("Profit ($)", color="tab:blue", fontweight="bold", fontsize=13)
                ax_plato.tick_params(axis='both', which='major', labelsize=12)
                ax_plato.grid(True, alpha=0.3)

                # ==============================
                # LINHA 1: WINRATE CONSISTENCY
                # ==============================
                ax_wr = axes[1, i]
                ax_wr2 = ax_wr.twinx()
                
                scores = self.calcular_winrate_consistencia(dados_forward, p)
                media_tr = self.calcular_media_das_janelas(resultados_tr[p])
                
                x_wr = sorted(scores.keys())
                y_wr = [scores[v] for v in x_wr]
                y_tr = [media_tr.get(v, 0) for v in x_wr]
                
                if x_wr: 
                    l2 = ax_wr2.fill_between(x_wr, 0, y_tr, color='gray', alpha=0.2, step="mid", label='Volume de Trades')
                    l1, = ax_wr.plot(x_wr, y_wr, marker="o", linewidth=3.0, markersize=7, color="tab:blue", label="Win Rate Médio")
                    ax_wr.axhline(50, linewidth=2.0, alpha=0.8, color="red", linestyle="--", label="Win Rate = 50%")
                    
                    lns = [l1, l2, ax_wr.lines[-1]]
                    ax_wr.legend(lns, [l.get_label() for l in lns], loc="upper left", fontsize=12)
                
                ax_wr.set_ylim(-5, 105)
                ax_wr2.set_ylim(bottom=0)
                
                ax_wr.set_title(f"{p} (Win Rate vs Amostra)", fontsize=15, fontweight="bold")
                ax_wr.set_ylabel("Win Rate (%)", color="tab:blue", fontweight="bold", fontsize=13)
                ax_wr2.set_ylabel("Quantidade de Trades", color="gray", fontweight="bold", fontsize=13)
                
                ax_wr.tick_params(axis='both', which='major', labelsize=12)
                ax_wr2.tick_params(axis='both', which='major', labelsize=12)
                ax_wr.grid(True, alpha=0.3)

                # ==============================
                # LINHAS 2 em diante: MATRIZ DE HEATMAPS TRANSPOSTA
                # ==============================
                for k, param_base in enumerate(self.parametros):
                    linha_atual = 2 + k 
                    ax_hm = axes[linha_atual, i]
                    
                    if p == param_base:
                        # Quadrado Branco (Diagonal da matriz onde o parâmetro cruza com ele mesmo)
                        ax_hm.text(0.5, 0.5, "Gráfico não aplicável\n(Mesmo parâmetro)", 
                                horizontalalignment='center', verticalalignment='center',
                                fontsize=14, color='gray', transform=ax_hm.transAxes)
                        ax_hm.set_xticks([])
                        ax_hm.set_yticks([])
                        ax_hm.set_title(f"Interação nula", fontsize=15, fontweight="bold", color="gray")
                    else:
                        # Otimização: Apenas filtra o DataFrame global já criado lá em cima (100x mais rápido)
                        if param_base in df_forward_all.columns and p in df_forward_all.columns and "profit" in df_forward_all.columns:
                            df_2d = df_forward_all[[param_base, p, "profit"]].dropna()
                            
                            if not df_2d.empty:
                                # Index (Eixo Y) = param_base (O que define a Linha da Matriz)
                                # Columns (Eixo X) = p (O que define a Coluna da Matriz)
                                pivot = df_2d.pivot_table(index=param_base, columns=p, values="profit", aggfunc="mean")
                                pivot = pivot.sort_index(ascending=False)
                                
                                # Suavização em 2D
                                pivot_smoothed = pivot.rolling(window=3, center=True, min_periods=1).mean()
                                pivot_smoothed = pivot_smoothed.T.rolling(window=3, center=True, min_periods=1).mean().T
                                
                                sns.heatmap(pivot_smoothed, cmap="RdYlGn", center=0, annot=False, ax=ax_hm, 
                                            cbar_kws={'label': 'Profit Médio Suavizado'})
                                
                                cbar = ax_hm.collections[0].colorbar
                                cbar.ax.tick_params(labelsize=11)
                                cbar.set_label('Profit Suavizado ($)', size=12, weight='bold')

                                ax_hm.set_title(f"Vizinhança: {param_base} vs {p}", fontsize=15, fontweight="bold")
                                ax_hm.set_ylabel(param_base, fontweight="bold", fontsize=13)
                                ax_hm.set_xlabel(p, fontweight="bold", fontsize=13)
                                ax_hm.tick_params(axis='both', which='major', labelsize=12)
                            else:
                                ax_hm.text(0.5, 0.5, "Dados insuficientes", horizontalalignment='center', verticalalignment='center')
                        else:
                            ax_hm.text(0.5, 0.5, "Dados insuficientes", horizontalalignment='center', verticalalignment='center')

            if df_csv_list:
                self._salvar_csv(pd.concat(df_csv_list, axis=1), "Plateau_Stability_Data")

            titulo_combinado = f"ESTABILIDADE DO PLATÔ, WIN RATE E MATRIZ GERAL DE CRUZAMENTOS\nConfiguração: {self.configuracao}   |   {info}"
            fig.suptitle(titulo_combinado, fontsize=22, fontweight="bold")
            
            plt.tight_layout(rect=[0, 0, 1, 0.96 - (0.005 * rows)])
            plt.savefig(str(caminho), dpi=100, bbox_inches="tight")
            plt.close()
            print(f"  [SALVO] {metrica_nome}")

    # ============================================================
    # FLUXO PRINCIPAL (EXECUÇÃO)
    # ============================================================
    def run(self) -> None:
        dados_back, dados_forward = {}, {}
        for j in range(1, self.n_janelas + 1):
            dados_back[j] = self.ler_xml(self.xml_dir / f"otimizacao_{j}.xml", "back")
            dados_forward[j] = self.ler_xml(self.xml_dir / f"otimizacao_{j}.forward.xml", "forward")
            
        # Exporta CSV Global e captura estatisticas
        estatisticas = self.calcular_estatisticas_forward(dados_forward)
        
        # Estrutura base de dados (Apenas o necessário para o gráfico principal)
        res_profit_global = {p: {j: self.calcular_medias_janela(dados_forward[j], p, "profit") for j in range(1, self.n_janelas+1)} for p in self.parametros}
        
        # Chamada ÚNICA para o gráfico mestre
        self.gerar_png_plato_e_winrate(res_profit_global, dados_forward, estatisticas)

# ============================================================
# ENTRYPOINT
# ============================================================
def main() -> int:
    parser = argparse.ArgumentParser(description="Robustness Analyzer Universal para MT5")
    parser.add_argument("configuracao", help="Nome da configuração (ex: PADRAO)")
    parser.add_argument("parametros", help="Lista de parâmetros separados por vírgula (ex: 'StopLoss,TakeProfit')")
    parser.add_argument("ea_nome", help="Nome do Expert Advisor")
    parser.add_argument("n_janelas", type=int, help="Número de janelas de otimização (ex: 4)")
    parser.add_argument("xml_dir", help="Caminho do diretório com os arquivos XML")
    parser.add_argument("intervalo", nargs="?", default="30 min", help="Intervalo de tempo (opcional, padrão: '30 min')")

    # Tratamento caso o usuário chame sem parâmetros para evitar stacktrace longo
    if len(sys.argv) == 1:
        parser.print_help(sys.stderr)
        return 1

    args = parser.parse_args()

    try:
        parametros_lista = [p.strip() for p in args.parametros.split(",") if p.strip()]
        
        analyzer = RobustnessAnalyzer(
            configuracao=args.configuracao.upper().strip(), 
            parametros=parametros_lista, 
            ea_nome=args.ea_nome.strip(), 
            n_janelas=args.n_janelas, 
            xml_dir=args.xml_dir.strip(), 
            intervalo=args.intervalo.strip()
        )
        analyzer.run()
        print("\n[SUCESSO] Processamento concluído. A Matriz de Robustez foi gerada com sucesso.")
        
    except Exception as e:
        print(f"\n[ERRO] Ocorreu uma falha no processamento: {e}")
        return 1

    return 0

if __name__ == "__main__":
    sys.exit(main())
