# -*- coding: utf-8 -*-

"""
ROBUSTNESS ANALYZER UNIVERSAL
=============================

Analisa os XMLs de otimização do MetaTrader 5 para QUALQUER EA.
Recebe os parâmetros dinamicamente do WFO Manager.
"""

import os
import csv
import math
import sys
import xml.etree.ElementTree as ET
from collections import defaultdict
from pathlib import Path
import matplotlib.pyplot as plt

# --- IMPORTAÇÕES PARA OS HEATMAPS ---
import pandas as pd
import seaborn as sns

# ============================================================
# VARIÁVEIS GLOBAIS (Preenchidas dinamicamente pelo Main)
# ============================================================

N_JANELAS = 4
EA_NOME = "Generic_EA"
PARAMETROS = []
CONFIGURACAO_ATUAL = "PADRAO"

# Colunas fixas do MetaTrader 5
COLUNA_BACK_RESULT = "Result"
COLUNA_FORWARD_RESULT = "Forward Result"
COLUNA_PROFIT = "Profit"
COLUNA_TRADES = "Trades"

# ============================================================
# DIRETÓRIO DE SAÍDA (Relativo à pasta do script)
# ============================================================
BASE_DIR = Path(__file__).resolve().parent

OUTPUT_DIR = BASE_DIR / "robustness_output"
PNG_BASE_DIR = OUTPUT_DIR / "png"
CSV_DIR = OUTPUT_DIR / "csv"

# ============================================================
# LOCALIZAÇÃO DO MT5
# ============================================================
def localizar_terminal_mt5():
    appdata = os.environ.get("APPDATA")
    if not appdata:
        return None
    raiz = Path(appdata) / "MetaQuotes" / "Terminal"
    if not raiz.exists():
        return None

    candidatos = []
    try:
        for terminal_dir in raiz.iterdir():
            if not terminal_dir.is_dir():
                continue
            quantidade = 0
            for janela in range(1, N_JANELAS + 1):
                arquivo = terminal_dir / f"otimizacao_{janela}.xml"
                if arquivo.is_file():
                    quantidade += 1
            if quantidade > 0:
                candidatos.append((quantidade, terminal_dir))
    except Exception:
        return None

    if not candidatos:
        return None
    candidatos.sort(key=lambda x: x[0], reverse=True)
    return str(candidatos[0][1])

XML_DIR = localizar_terminal_mt5()

# ============================================================
# UTILITÁRIOS
# ============================================================
def garantir_diretorios():
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    PNG_BASE_DIR.mkdir(parents=True, exist_ok=True)
    CSV_DIR.mkdir(parents=True, exist_ok=True)

def limpar_nome_arquivo(texto):
    caracteres = '<>:"/\\|?*'
    resultado = texto
    for caractere in caracteres:
        resultado = resultado.replace(caractere, "_")
    return resultado

def numero(texto):
    if texto is None:
        return None
    texto = str(texto).strip()
    if texto == "":
        return None
    texto = texto.replace(",", ".")
    try:
        valor = float(texto)
        if math.isnan(valor):
            return None
        return valor
    except (ValueError, TypeError):
        return None

def valor_numerico_parametro(texto):
    valor = numero(texto)
    if valor is None:
        return None
    if float(valor).is_integer():
        return int(valor)
    return valor

def formatar_numero(valor):
    if isinstance(valor, int):
        return str(valor)
    if isinstance(valor, float):
        if valor.is_integer():
            return str(int(valor))
        return f"{valor:g}"
    return str(valor)

# ============================================================
# XML
# ============================================================
def nome_local(tag):
    if "}" in tag:
        return tag.split("}", 1)[1]
    return tag

def encontrar_planilha(root):
    for elemento in root.iter():
        if nome_local(elemento.tag).lower() == "table":
            return elemento
    return None

def encontrar_linhas(table):
    linhas = []
    for elemento in table:
        if nome_local(elemento.tag).lower() == "row":
            linhas.append(elemento)
    return linhas

def extrair_celulas(row):
    valores = []
    for cell in row:
        if nome_local(cell.tag).lower() != "cell":
            continue
        texto = None
        for filho in cell.iter():
            if nome_local(filho.tag).lower() == "data":
                texto = filho.text
                break
        if texto is None:
            texto = ""
        valores.append(texto.strip() if isinstance(texto, str) else "")
    return valores

def ler_xml(caminho, tipo):
    print(f"\n{'-'*70}\nArquivo: {os.path.basename(caminho)}")
    if not os.path.isfile(caminho):
        raise FileNotFoundError(f"Arquivo não encontrado:\n{caminho}")

    try:
        tree = ET.parse(caminho)
    except ET.ParseError as erro:
        raise RuntimeError(f"Erro ao interpretar XML:\n{erro}")

    root = tree.getroot()
    table = encontrar_planilha(root)
    if table is None:
        raise RuntimeError("Nenhuma <Table> foi encontrada no XML.")

    linhas = encontrar_linhas(table)
    if not linhas:
        raise RuntimeError("Nenhuma <Row> foi encontrada no XML.")

    header = extrair_celulas(linhas[0])
    header = [str(x).strip() for x in header]

    print("\nColunas encontradas:")
    for indice, nome in enumerate(header):
        print(f"  {indice:02d}: {nome}")

    resultado_coluna = COLUNA_BACK_RESULT if tipo == "back" else COLUNA_FORWARD_RESULT

    obrigatorias = [resultado_coluna, COLUNA_PROFIT, COLUNA_TRADES] + PARAMETROS
    faltando = [coluna for coluna in obrigatorias if coluna not in header]

    if faltando:
        raise RuntimeError("Colunas obrigatórias não encontradas no XML:\n  - " + "\n  - ".join(faltando))

    indices = {nome: header.index(nome) for nome in obrigatorias}
    registros = []

    for row_number, row in enumerate(linhas[1:], start=2):
        valores = extrair_celulas(row)
        if not valores:
            continue
        if len(valores) < len(header):
            valores += [""] * (len(header) - len(valores))

        resultado = numero(valores[indices[resultado_coluna]])
        profit = numero(valores[indices[COLUNA_PROFIT]])
        trades = numero(valores[indices[COLUNA_TRADES]])

        parametros_linha = {}
        linha_valida = True
        for parametro in PARAMETROS:
            valor = valor_numerico_parametro(valores[indices[parametro]])
            if valor is None:
                linha_valida = False
                break
            parametros_linha[parametro] = valor

        if not linha_valida or resultado is None:
            continue

        registro = {"result": resultado, "profit": profit, "trades": trades}
        registro.update(parametros_linha)
        registros.append(registro)

    if not registros:
        raise RuntimeError("Nenhum registro de otimização válido foi encontrado.")

    print(f"\nRegistros válidos encontrados: {len(registros)}")
    return registros

# ============================================================
# CÁLCULOS MATEMÁTICOS
# ============================================================
def calcular_medias_janela(registros, parametro, chave_metrica="result"):
    grupos = defaultdict(list)
    for registro in registros:
        valor_parametro = registro[parametro]
        valor_metrica = registro[chave_metrica]
        if valor_metrica is not None:
            grupos[valor_parametro].append(valor_metrica)

    medias = {}
    for valor, valores_metrica in grupos.items():
        if valores_metrica:
            medias[valor] = sum(valores_metrica) / len(valores_metrica)
    return medias

def calcular_media_das_janelas(medias_janelas):
    valores = set()
    for dados in medias_janelas.values():
        valores.update(dados.keys())

    resultado_final = {}
    for valor in valores:
        lista = []
        for janela in sorted(medias_janelas):
            dados = medias_janelas[janela]
            if valor in dados:
                lista.append(dados[valor])
        if lista:
            resultado_final[valor] = sum(lista) / len(lista)
    return resultado_final

def calcular_estatisticas_forward(dados_forward):
    profits, trades = [], []
    for janela in sorted(dados_forward):
        for registro in dados_forward[janela]:
            if registro.get("profit") is not None:
                profits.append(registro["profit"])
            if registro.get("trades") is not None:
                trades.append(registro["trades"])

    media_profit = sum(profits) / len(profits) if profits else None
    positivos = sum(1 for profit in profits if profit > 0)
    percentual_positivo = (positivos / len(profits) * 100.0) if profits else None
    media_trades = sum(trades) / len(trades) if trades else None

    return {
        "media_profit": media_profit,
        "media_trades": media_trades,
        "percentual_positivo": percentual_positivo,
        "total_configuracoes": len(profits),
        "configuracoes_positivas": positivos,
    }

# ============================================================
# HEATMAPS 2D
# ============================================================
def calcular_media_2d_todas_janelas(dados_forward, param_y, param_x, chave_metrica="result"):
    combinacoes = defaultdict(list)
    
    for janela, registros in dados_forward.items():
        for reg in registros:
            val_y = reg.get(param_y)
            val_x = reg.get(param_x)
            valor_metrica = reg.get(chave_metrica) 
            
            if val_y is not None and val_x is not None and valor_metrica is not None:
                combinacoes[(val_y, val_x)].append(valor_metrica)

    dados_plot = []
    coluna_destino = f"Media_{chave_metrica.capitalize()}"
    
    for (y, x), resultados in combinacoes.items():
        media = sum(resultados) / len(resultados)
        dados_plot.append({param_y: y, param_x: x, coluna_destino: media})

    return pd.DataFrame(dados_plot)

def plotar_heatmap(df, param_y, param_x, caminho_salvar, configuracao, metrica_nome="Result"):
    if df.empty:
        return

    coluna_valores = f"Media_{metrica_nome}"
    matriz = df.pivot(index=param_y, columns=param_x, values=coluna_valores)
    matriz = matriz.sort_index(ascending=False)

    plt.figure(figsize=(10, 8))
    ax = sns.heatmap(matriz, cmap="RdYlGn", annot=False, fmt=".2f", linewidths=0, cbar_kws={'label': f'Média do {metrica_nome}'})
    
    plt.title(f"Heatmap de Robustez: {param_y} vs {param_x}\nConfig: {configuracao} | Métrica: {metrica_nome}", fontsize=14, fontweight="bold")
    plt.xlabel(param_x, fontsize=11)
    plt.ylabel(param_y, fontsize=11)
    
    plt.tight_layout()
    plt.savefig(caminho_salvar, dpi=150, bbox_inches="tight")
    plt.close()

# ============================================================
# EXPORTAÇÃO (CSV E GRÁFICOS LINHA)
# ============================================================
def salvar_csv(parametro, medias_janelas, sufixo_metrica=""):
    caminho = CSV_DIR / f"{limpar_nome_arquivo(parametro)}{sufixo_metrica}.csv"
    valores = set()
    for dados in medias_janelas.values():
        valores.update(dados.keys())
    valores = sorted(valores)
    media_final = calcular_media_das_janelas(medias_janelas)

    with open(caminho, "w", newline="", encoding="utf-8-sig") as arquivo:
        writer = csv.writer(arquivo, delimiter=";")
        cabecalho = ["Valor"] + [f"J{i}" for i in range(1, N_JANELAS + 1)] + ["Media_Geral"]
        writer.writerow(cabecalho)
        for valor in valores:
            linha = [valor]
            for janela in range(1, N_JANELAS + 1):
                v_janela = medias_janelas.get(janela, {}).get(valor)
                linha.append(f"{v_janela:.8f}" if v_janela is not None else "")
            
            final = media_final.get(valor)
            linha.append(f"{final:.8f}" if final is not None else "")
            writer.writerow(linha)
    return str(caminho)

def plotar_parametro(ax, parametro, medias_janelas, metrica_nome="Result"):
    valores = set()
    for dados in medias_janelas.values():
        valores.update(dados.keys())
    valores = sorted(valores)
    media_final = calcular_media_das_janelas(medias_janelas)

    x = [v for v in valores if v in media_final]
    y = [media_final[v] for v in x]

    if x:
        ax.plot(x, y, marker="o", linewidth=1.5, markersize=3, label="Média geral")
    ax.axhline(0, linewidth=0.8, alpha=0.4, color="gray")
    ax.set_title(parametro, fontsize=11, fontweight="bold")
    ax.set_xlabel(parametro, fontsize=9)
    ax.set_ylabel(f"Média ({metrica_nome})", fontsize=9)
    ax.grid(True, alpha=0.25)
    ax.tick_params(axis="both", labelsize=8)

def gerar_png_forward(resultados_forward, estatisticas, configuracao, metrica_nome="Result"):
    nome_arquivo = f"{limpar_nome_arquivo(configuracao)}_{metrica_nome}.png"
    caminho = PNG_BASE_DIR / nome_arquivo

    qtd_params = len(PARAMETROS)
    colunas = min(3, qtd_params) if qtd_params > 0 else 1
    linhas = math.ceil(qtd_params / colunas) if qtd_params > 0 else 1

    fig, axes = plt.subplots(linhas, colunas, figsize=(18, 5 * linhas))
    
    if qtd_params <= 1:
        axes = [axes]
    else:
        axes = axes.flatten()

    for indice, parametro in enumerate(PARAMETROS):
        plotar_parametro(axes[indice], parametro, resultados_forward[parametro], metrica_nome)

    if qtd_params < len(axes):
        for indice in range(qtd_params, len(axes)):
            axes[indice].axis("off")

    mp = estatisticas["media_profit"]
    mt = estatisticas["media_trades"]
    pp = estatisticas["percentual_positivo"]
    tc = estatisticas["total_configuracoes"]
    cp = estatisticas["configuracoes_positivas"]

    t_profit = f"Média Profit: {mp:.2f}" if mp is not None else "Média Profit: N/D"
    t_trades = f"Média Trades: {mt:.2f}" if mt is not None else "Média Trades: N/D"
    t_pos = f"% Profit positivo: {pp:.2f}% ({cp}/{tc})" if pp is not None else "% Profit positivo: N/D"

    informacoes = f"{t_profit}   |   {t_trades}   |   {t_pos}"

    fig.suptitle(
        f"FORWARD — Robustness ({EA_NOME})\nConfiguração: {configuracao} | Métrica: {metrica_nome}",
        fontsize=16, fontweight="bold"
    )
    fig.text(0.5, 0.93 - (0.015 * linhas), informacoes, ha="center", va="center", fontsize=11, fontweight="bold")
    
    plt.tight_layout(rect=[0, 0, 1, 0.90 - (0.01 * linhas)])
    plt.savefig(str(caminho), dpi=160, bbox_inches="tight")
    plt.close(fig)
    return str(caminho)

# ============================================================
# MAIN
# ============================================================
def main():
    global PARAMETROS, EA_NOME, CONFIGURACAO_ATUAL

    if len(sys.argv) < 3:
        print("\nERRO: Argumentos insuficientes.")
        print("Uso esperado: python robustness_analyzer.py <CONFIG> <PARAM1,PARAM2,...> [NOME_EA]")
        return 1

    CONFIGURACAO_ATUAL = sys.argv[1].upper().strip()
    parametros_str = sys.argv[2]
    PARAMETROS = [p.strip() for p in parametros_str.split(",") if p.strip()]
    
    if len(sys.argv) >= 4:
        EA_NOME = sys.argv[3].strip()

    if not PARAMETROS:
        print("\nERRO: Nenhum parâmetro recebido para análise.")
        return 1

    print("=" * 70)
    print(f"ROBUSTNESS ANALYZER UNIVERSAL — {EA_NOME}")
    print("=" * 70)
    print(f"\nConfiguração Atual : {CONFIGURACAO_ATUAL}")
    print(f"Parâmetros ({len(PARAMETROS)}):")
    for p in PARAMETROS:
        print(f"  - {p}")
    print(f"\nDiretório de saída:\n  {OUTPUT_DIR}")

    if XML_DIR is None or not os.path.isdir(XML_DIR):
        print("\nERRO: Nenhum terminal MT5 com XMLs de otimização foi encontrado.")
        return 1

    garantir_diretorios()

    arquivos_back, arquivos_forward = {}, {}
    faltando_back, faltando_forward = [], []

    print("\n" + "="*70 + "\nLOCALIZANDO XMLs\n" + "="*70)
    for janela in range(1, N_JANELAS + 1):
        cb = os.path.join(XML_DIR, f"otimizacao_{janela}.xml")
        cf = os.path.join(XML_DIR, f"otimizacao_{janela}.forward.xml")
        
        if os.path.isfile(cb):
            arquivos_back[janela] = cb
            print(f"  [BACK] J{janela}: {cb}")
        else:
            faltando_back.append(janela)
            
        if os.path.isfile(cf):
            arquivos_forward[janela] = cf
            print(f"  [FORW] J{janela}: {cf}")
        else:
            faltando_forward.append(janela)

    if faltando_back or faltando_forward:
        print("\nERRO: Faltam arquivos XML para as janelas (BACK:", faltando_back, "| FORWARD:", faltando_forward, ")")
        return 1

    dados_back, dados_forward = {}, {}
    for j in range(1, N_JANELAS + 1):
        dados_back[j] = ler_xml(arquivos_back[j], "back")
        dados_forward[j] = ler_xml(arquivos_forward[j], "forward")
        
    estatisticas = calcular_estatisticas_forward(dados_forward)

    metricas_para_analise = [
        ("result", "Result"), 
        ("profit", "Profit")
    ]

    for chave_metrica, metrica_nome in metricas_para_analise:
        print("\n" + "="*70)
        print(f"PROCESSANDO DADOS PARA: {metrica_nome.upper()}")
        print("="*70)
        
        resultados_back, resultados_forward = {}, {}

        for parametro in PARAMETROS:
            mb_janelas, mf_janelas = {}, {}
            for janela in range(1, N_JANELAS + 1):
                mb_janelas[janela] = calcular_medias_janela(dados_back[janela], parametro, chave_metrica)
                mf_janelas[janela] = calcular_medias_janela(dados_forward[janela], parametro, chave_metrica)

            resultados_back[parametro] = mb_janelas
            resultados_forward[parametro] = mf_janelas

            salvar_csv(f"{parametro}_BACK", mb_janelas, f"_{metrica_nome}")
            salvar_csv(f"{parametro}_FORWARD", mf_janelas, f"_{metrica_nome}")

        print(f"\n  Gerando PNGs de Linha ({metrica_nome})...")
        c_forw = gerar_png_forward(resultados_forward, estatisticas, CONFIGURACAO_ATUAL, metrica_nome)
        print(f"  [OK] Salvo em: {c_forw}")
        
        # --------------------------------------------------------
        # HEATMAPS COM NOMES CUSTOMIZADOS
        # --------------------------------------------------------
        # Tupla: (Eixo Y, Eixo X, Nome Simplificado para o Arquivo)
        pares_heatmaps = [
            ("Espacamento_Filtro_Estocastico1", "Periodo_Filtro_Estocastico1", "Filtro_Estocastico"),
            ("Linha_Filtro_ADX1", "Periodo_Filtro_ADX1", "Filtro_ADX")
        ]

        print(f"\n  Gerando Heatmaps ({metrica_nome})...")
        for param_y, param_x, nome_amigavel in pares_heatmaps:
            if param_y in PARAMETROS and param_x in PARAMETROS:
                df_hm = calcular_media_2d_todas_janelas(dados_forward, param_y, param_x, chave_metrica)
                
                # Exemplo: TTT_Filtro_Estocastico_Heatmap_Result.png
                nome_arq_hm = f"{limpar_nome_arquivo(CONFIGURACAO_ATUAL)}_{nome_amigavel}_Heatmap_{metrica_nome}.png"
                caminho_hm = PNG_BASE_DIR / nome_arq_hm
                
                plotar_heatmap(df_hm, param_y, param_x, caminho_hm, CONFIGURACAO_ATUAL, metrica_nome)
                print(f"  [OK] Heatmap salvo: {caminho_hm}")
            else:
                print(f"  [IGNORADO] Parâmetros {param_y} ou {param_x} não encontrados nesta rodada.")

    print("\n" + "="*70 + "\nROBUSTNESS CONCLUÍDO COM SUCESSO\n" + "="*70 + "\n")

    return 0

if __name__ == "__main__":
    raise SystemExit(main())
